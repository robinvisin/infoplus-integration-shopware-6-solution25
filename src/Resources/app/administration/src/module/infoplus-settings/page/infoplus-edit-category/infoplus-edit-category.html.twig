<sw-page>
    <template #content>
        <sw-card-view>
            <div class="infoplus-content">
                <mt-card :title="$tc('infoplus.category.editTitle')">
                    <mt-text-field
                        v-model="categoryName"
                        :label="$tc('infoplus.category.name')"
                        name="categoryName"
                        :placeholder="$tc('infoplus.category.namePlaceholder')"
                        :disabled="isLoading"
                    ></mt-text-field>
                    <mt-button
                        variant="primary"
                        :disabled="isLoading"
                        @click="saveCategory"
                    >
                        {{ $tc('infoplus.category.save') }}
                    </mt-button>
                    <mt-button
                        variant="primary" ghost
                        :disabled="isLoading"
                        @click="$router.back()"
                    >
                        {{ $tc('infoplus.category.cancel') }}
                    </mt-button>
                </mt-card>
            </div>
        </sw-card-view>
    </template>
</sw-page>