<sw-page>
    <template #content>
        <sw-card-view>
            <div class="infoplus-edit-customfield">
                <mt-card :title="$tc('infoplus.customfield.edit')">
                    <mt-text-field
                        :label="$tc('infoplus.customfield.columns.technicalName')"
                        v-model="customField.technicalName"
                        :required="true"
                    />
                    <mt-text-field
                        :label="$tc('infoplus.customfield.columns.label')"
                        v-model="customField.label"
                        :required="true"
                    />
                    <mt-select
                        :label="$tc('infoplus.customfield.columns.type')"
                        v-model:value="customField.type"
                        :options="typeOptions"
                    >
                        <option
                            v-for="typeOption in typeOptions"
                            :key="typeOption.value"
                            :value="typeOption.value"
                        >
                            {{ typeOption.label }}
                        </option>
                    </mt-select>
                    <template v-if="customField.type === 'select'">
                        <mt-textarea
                            :label="$tc('infoplus.customfield.columns.options')"
                            v-model="customField.optionsString"
                            :placeholder="$tc('infoplus.customfield.optionsPlaceholderNewline')"
                        />
                    </template>
                    <mt-switch
                        :label="$tc('infoplus.customfield.columns.isRequired')"
                        v-model:value="customField.isRequired"
                    />
                    <mt-number-field
                        :label="$tc('infoplus.customfield.columns.position')"
                        v-model="customField.position"
                        :required="false"
                    />
                    <mt-number-field
                        :label="$tc('infoplus.customfield.columns.staticPrice')"
                        v-model="customField.staticPrice"
                        :digits="2"
                        :placeholder="$tc('infoplus.customfield.staticPriceHelp')"
                    />
                    <mt-switch
                        :label="$tc('infoplus.customfield.columns.active')"
                        v-model:value="customField.active"
                    />
                    <mt-switch
                        :label="$tc('infoplus.customfield.columns.showInStorefront')"
                        v-model:value="customField.showInStorefront"
                    />
                    <mt-button
                        variant="primary"
                        @click="saveCustomField"
                    >
                        {{ $tc('infoplus.customfield.save') }}
                    </mt-button>
                    <mt-button
                        variant="primary" ghost
                        :disabled="isLoading"
                        @click="$router.back()"
                    >
                        {{ $tc('infoplus.category.cancel') }}
                    </mt-button>
                </mt-card>
            </div>
        </sw-card-view>
    </template>
</sw-page>