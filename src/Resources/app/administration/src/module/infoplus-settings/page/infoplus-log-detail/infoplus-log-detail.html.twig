<sw-page>
    <template #content>
        <sw-card-view>
            <div
                class="infoplus-content"
                style="display: flex; justify-content: flex-end; margin-bottom: 20px;"
            >
                <mt-button
                    variant="secondary"
                    @click="$router.back()"
                >
                    {{ $tc('infoplus.logs.back') }}
                </mt-button>
            </div>
            <mt-card
                :title="$tc('infoplus.logs.title', 0, { file: file })"
                :is-loading="isLoading"
            >
                <template v-if="error">
                    <sw-alert variant="error">{{ error }}</sw-alert>
                </template>

                <template v-else>
                    <div
                        class="log-content"
                        style="overflow-x: scroll"
                    >
                        <div
                            v-for="line in lines"
                            :key="lineIndex(line)"
                            style="margin: 5px 0;"
                        >
                            <pre>{{ line }}</pre>
                        </div>
                    </div>
                    <sw-pagination
                        :total="totalLines"
                        :limit="pagination.limit"
                        :page="pagination.page"
                        @page-change="onPageChange"
                    />
                    <mt-button @click="downloadLog">
                        {{ $tc('infoplus.logs.download') }}
                    </mt-button>
                </template>
            </mt-card>
        </sw-card-view>
    </template>
</sw-page>